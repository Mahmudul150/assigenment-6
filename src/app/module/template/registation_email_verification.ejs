
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verification</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">

  <div style="max-width: 600px; margin: 30px auto; background-color: #ffffff; padding: 30px; border-radius: 10px;">

    <h2 style="color: #2563eb; text-align: center;">
      Developer Assessment Platform
    </h2>

    <h3>Hello, <%= name %>!</h3>

    <p>
      Thank you for registering with Developer Assessment Platform.
      Please use the OTP below to verify your email address.
    </p>

    <p><strong>Email:</strong> <%= email %></p>

    <div style="text-align: center; margin: 30px 0;">
      <span style="display: inline-block; padding: 15px 30px; background-color: #2563eb; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 8px; border-radius: 8px;">
        <%= otp %>
      </span>
    </div>

    <p>
      If you did not create this account, please ignore this email.
    </p>

    <p style="color: #666666; font-size: 12px; text-align: center; margin-top: 30px;">
      &copy; Developer Assessment Platform. All rights reserved.
    </p>

  </div>

</body>
</html>
