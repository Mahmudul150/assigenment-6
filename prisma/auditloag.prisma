model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String 
  entityType String 
  entityId   String?
  metadata   Json? 
  createdAt  DateTime @default(now())

  
  actor User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")

}
